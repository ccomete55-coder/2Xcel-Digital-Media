# Copy to ".env" for local dev. On Render, set these in the service's
# Environment tab instead — never commit the real values.

# Render injects PORT automatically; only needed for local runs.
PORT=10000

# Shared secret the caller (the audit routine) must send as the
# "x-api-key" header on every request except /health. Generate a long
# random value, e.g.: openssl rand -hex 32
AUDIT_SERVICE_API_KEY=

# Hard ceiling on how long a single crawl may run before it's killed.
JOB_TIMEOUT_MS=480000

# Default page cap per crawl (keeps a lead-magnet audit fast/cheap).
# Caller can override per-request up to a hard max of 500.
DEFAULT_MAX_PAGES=150
