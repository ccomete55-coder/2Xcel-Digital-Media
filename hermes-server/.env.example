# ============================================================================
# HERMES VPS ENVIRONMENT — copy to ".env" on the server and fill in.
# NEVER commit the real .env. These secrets stay on the VPS only.
# ============================================================================

# Port the Node service listens on (Nginx proxies 443 -> this).
PORT=8080

# Comma-separated list of browser origins allowed to call this service.
ALLOWED_ORIGINS=https://2xcel.net,https://www.2xcel.net

# Shared secret — set the SAME value as the assistant's Server URL secret
# in the Vapi dashboard. Requests without it are rejected.
VAPI_WEBHOOK_SECRET=

# Vendor API keys (backend only — the website never receives these)
VAPI_PRIVATE_KEY=
SYSTEMEIO_API_KEY=
TASKADE_API_KEY=
HIGGSFIELD_API_KEY=

# systeme.io tag ID applied to every new lead (Contacts > Tags in the
# systeme.io dashboard). Set an automation rule there — "when tag added,
# enroll in campaign" — to trigger the email sequence. Leave blank to just
# record the contact without tagging.
SYSTEMEIO_TAG_ID=

# Google Calendar API (for booking meetings with Google Meet links)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_EMAIL=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Edmonton

# Sender used for the white-labeled audit email (Phase 3), e.g. hello@2xcel.net
AUDIT_FROM_EMAIL=hello@2xcel.net
